# ============================================================
# Acme Desk — settings. Copy to .env; every default runs offline.
# ============================================================

# --- LLM (answers from checkpoint 02 on) ---
LLM_PROVIDER=gemini                 # gemini | azure
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Embeddings: local (default, offline) | gemini | azure | ollama ---
EMBEDDING_PROVIDER=local

# --- Part 1: the document source ---
SOURCE=local                        # local | drive | onedrive
SOURCE_DIR=workspace/local-drive    # the folder that plays Google Drive when SOURCE=local
SEED_DIR=shared/data                # Friday's snapshot: sites/, register.json, identities.json, events/
REGISTER_SOURCE=local               # local | drive  (drive = _register.json in the Drive root folder)
REGISTER_FILE=shared/data/register.json
IDENTITIES_FILE=shared/data/identities.json
DRIVE_SA_KEY=secrets/acme-desk-sa.json   # service-account JSON key (never committed)
DRIVE_ROOT_FOLDER_ID=               # the "Acme Corp Documents" folder, from its URL
DRIVE_DOC_EXPORT=markdown           # markdown | html, for native Google Docs
# OneDrive / SharePoint (SOURCE=onedrive), see docs/onedrive-setup.md
ONEDRIVE_AUTH=device                # device (sign in once: onedrive_admin.py login) | app (client secret, work/school)
ONEDRIVE_TENANT_ID=                 # Directory (tenant) ID; a personal account with device: consumers
ONEDRIVE_CLIENT_ID=                 # the app registration's Application (client) ID
ONEDRIVE_CLIENT_SECRET=             # app only: the secret's Value (never committed)
ONEDRIVE_DRIVE=                     # empty = your own OneDrive (device); someone@yourco.com; or a drive id (b!...)
ONEDRIVE_FOLDER=Acme Corp Documents # path from the drive's root
ONEDRIVE_TOKEN_CACHE=secrets/onedrive-token.json   # device only: the refresh token
SYNC_INTERVAL_SECONDS=0             # Part 1: 0 = scheduler off. Part 2 worker: 0 = only on Run now; 60 in class
VECTOR_STORE=chroma                 # Part 1: chroma (files in chroma_data/) | postgres (pgvector in the compose db, database acme_part1)
# VECTOR_DB_URL=postgresql://postgres:postgres-local-only@localhost:5433/acme_part1

# --- Part 2: the platform (Postgres, sign-in, tenants) ---
# docker compose up -d db, then: python checkpoints/02-platform/db.py migrate && ... db.py seed
# Three roles, three URLs. The API never gets the ADMIN one; the worker
# never gets the APP one. Local-only passwords: change them anywhere real.
DATABASE_ADMIN_URL=postgresql://postgres:postgres-local-only@localhost:5433/acme
DATABASE_APP_URL=postgresql://acme_app:app-local-only@localhost:5433/acme
DATABASE_SYNC_URL=postgresql://acme_sync:sync-local-only@localhost:5433/acme
ACME_SEED_PASSWORD=                 # empty: db.py seed prints a random password per demo account
COOKIE_SECURE=false                 # true behind HTTPS
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=168
RETRIEVAL_STRATEGY=hybrid           # dense (meaning, pgvector) | keyword (words, Postgres full-text) | hybrid (both, fused)
HISTORY_TURNS=6                     # the chat: earlier question + answer pairs the model sees

# --- Part 3: tools ---
GRAPH=workflow                      # workflow | agent
MAX_TOOL_STEPS=6
MAX_TOOL_CALLS_PER_TURN=4
BUDGET_USD_PER_RUN=0.25

# --- Part 4: release ---
GUARD=on                            # on | off
ACME_KILL_SWITCH=                   # "" | tools | all
ACME_ADMIN_KEY=k-admin
